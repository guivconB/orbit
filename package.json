{
  "name": "orbit",
  "private": true,
  "version": "4.0.0",
  "description": "Painel de utilidades pessoal e modular para Windows",
  "author": "guivconB",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev:react": "vite",
    "dev:electron": "tsup electron/main.ts electron/preload.ts --format cjs --out-dir dist-electron --external electron,better-sqlite3 --watch --onSuccess \"wait-on tcp:5173 && electron . --dev\"",
    "dev": "concurrently -k \"npm run dev:react\" \"npm run dev:electron\"",
    "build:react": "vite build",
    "build:electron": "tsup electron/main.ts electron/preload.ts --format cjs --out-dir dist-electron --external electron,better-sqlite3",
    "build": "npm run build:react && npm run build:electron",
    "prepack": "node -e \"try{require('child_process').execSync('taskkill /F /IM Orbit.exe 2>nul',{stdio:'ignore'})}catch(e){}\"",
    "pack": "npm run build && electron-builder --dir",
    "predist": "node -e \"try{require('child_process').execSync('taskkill /F /IM Orbit.exe 2>nul',{stdio:'ignore'})}catch(e){}\"",
    "dist": "npm run build && electron-builder",
    "start": "npm run build && electron .",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.orbit.app",
    "productName": "Orbit",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/generative-ai": "^0.24.1",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.44.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  }
}
